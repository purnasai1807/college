# PostgreSQL (use a generated alphanumeric password for Docker Compose)
DB_PASSWORD=replace-with-a-long-random-alphanumeric-password
DATABASE_URL=postgresql://canteen:replace-with-a-long-random-alphanumeric-password@localhost:5432/canteen

# Application and authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Razorpay sandbox keys; configure live credentials only in production secrets
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Optional password-reset email (Resend)
RESEND_API_KEY=
MAIL_FROM=Canteen <no-reply@example.edu>

# Optional S3-compatible food-image storage
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_REGION=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_STORAGE_PUBLIC_URL=

# First-run deployment setup
CANTEEN_NAME=College Canteen
COLLEGE_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Development-only sample menu and accounts (never enable in production)
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=

# Operational tuning
RESERVATION_MINUTES=10
KITCHEN_LANES=3
CRON_SECRET=
